{
  "name": "mml-manager-frontend",
  "version": "0.1.2",
  "description": "MML配置管理前端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "npm run format:vue && npm run format:python",
    "format:check": "npm run format:check:vue && npm run format:check:python",
    "format:vue": "prettier --write .",
    "format:check:vue": "npm run check:vue-order && prettier --check .",
    "check:vue-order": "node scripts/check-vue-block-order.mjs",
    "format:python": "python -m black ../backend/src/app ../backend/tests",
    "format:check:python": "python -m black --check ../backend/src/app ../backend/tests"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "element-plus": "^2.9.1",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "3.6.2",
    "vite": "^6.3.2"
  }
}
